{
  "name": "quanticdata-mcp",
  "version": "0.11.13",
  "mcpName": "io.github.quantumproxies/quanticdata-mcp",
  "description": "MCP server for the QuanticData API — scrape, search, map, crawl the web and pull residential/datacenter/mobile proxies for AI agents. Connect QuanticData to Claude, Cursor, and any MCP client.",
  "type": "module",
  "bin": {
    "quanticdata-mcp": "dist/index.js",
    "quanticdata-mcp-remote": "dist/remote.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "sync": "./sync-from-scraper-mcp.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "web-scraping",
    "scraper",
    "markdown",
    "serp",
    "serp-api",
    "web-search",
    "crawl",
    "web-unlocker",
    "proxy",
    "residential-proxies",
    "mobile-proxies",
    "ai-agents",
    "llm",
    "rag",
    "claude",
    "cursor",
    "quanticdata"
  ],
  "author": "QuanticData <support@quanticdata.io> (https://quanticdata.io)",
  "license": "MIT",
  "homepage": "https://quanticdata.io/mcp-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantumproxies/quanticdata-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/quantumproxies/quanticdata-mcp-server/issues",
    "email": "support@quanticdata.io"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@posthog/mcp": "^0.16.0",
    "posthog-node": "^5.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.3"
  }
}
