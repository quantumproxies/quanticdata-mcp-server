{
  "name": "quanticdata-mcp",
  "version": "0.8.2",
  "mcpName": "io.github.quantumproxies/quanticdata-mcp",
  "description": "MCP server for the QuanticData API — scrape, search, map, crawl the web and pull residential/datacenter/mobile proxies for AI agents. Connect QuanticData to Claude, Cursor, and any MCP client.",
  "type": "module",
  "bin": {
    "quanticdata-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "sync": "./sync-from-scraper-mcp.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scraper",
    "proxy",
    "quanticdata",
    "claude",
    "cursor",
    "web-scraping",
    "serp",
    "crawl",
    "residential-proxies",
    "ai-agents"
  ],
  "author": "QuanticData <support@quanticdata.io> (https://quanticdata.io)",
  "license": "MIT",
  "homepage": "https://quanticdata.io/mcp-server",
  "bugs": {
    "email": "support@quanticdata.io"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.3"
  }
}
